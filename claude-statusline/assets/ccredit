#!/usr/bin/env bash
# Usage-credit meter control.
#
# claude.ai login (the normal case) - the balance is fetched live, nothing to type:
#   ccredit                 show the cached balance and how fresh it is
#   ccredit refresh         fetch now and print the raw server answers (first-time check)
#   ccredit total 40        meter against $40 (default: balance after the last top-up seen)
#   ccredit total auto      back to automatic
#   ccredit mode credits    always show the credit row on line 2
#   ccredit mode quota      never show it (and stop fetching)
#   ccredit mode auto       show it while credits are being drawn on (default)
#   ccredit window 600      seconds a balance drop keeps the row on (default 600)
#
# Console API-key billing (no claude.ai login, so no live balance) - anchor by hand:
#   ccredit set 35.06       re-anchor to what Console shows; also re-learns calibration
#   ccredit topup 20        add a top-up to the anchor
#   ccredit cal 1.37        set the calibration factor by hand
set -euo pipefail
CFG="$HOME/.claude/credit-config"
LDIR="$HOME/.claude/credit-ledger.d"
LIVE="$HOME/.claude/credit-live"
FETCH="$HOME/.claude/credit-balance.sh"

# ---- key=value store (only lines matching ^KEY= are touched; comments survive)
getk() { [ -f "$CFG" ] && sed -n "s/^$1=\(.*\)/\1/p" "$CFG" 2>/dev/null | head -1 || true; }
setk() {   # $1 key  $2 value ('' deletes)
    _t="$CFG.tmp.$$"
    umask 077
    { [ -f "$CFG" ] && grep -v "^$1=" "$CFG" || true; } > "$_t"
    [ -n "$2" ] && printf '%s=%s\n' "$1" "$2" >> "$_t"
    mv -f "$_t" "$CFG"
}
num() { case "$1" in ''|*[!0-9.]*|.|*.*.*) return 1 ;; *) return 0 ;; esac; }

# ---- legacy hand-anchor (Console API-key billing)
write_anchor() {   # $1 balance   $2 calibration
    setk BALANCE "$1"
    setk BALANCE_AT "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    setk CAL "$2"
    # Both derived stores measure spend SINCE the anchor, so both reset with it.
    rm -rf "$LDIR" 2>/dev/null || true
    rm -f "${TMPDIR:-/tmp}"/cc-credit-spend-* 2>/dev/null || true
}
BALANCE=$(getk BALANCE); BALANCE_AT=$(getk BALANCE_AT); CAL=$(getk CAL)
: "${BALANCE:=0}" "${BALANCE_AT:=never}" "${CAL:=1.0}"
measured_spend() {
    find "$LDIR" -type f -name 's-*' -print0 2>/dev/null \
      | xargs -0 cat 2>/dev/null \
      | awk -v c="$CAL" 'NF==3 { d=$3-$2; if(d<0) d=0; s+=$1+d }
                         END{ c=c+0; if(c<=0) c=1; printf "%.6f", (s+0)*c }'
}
# Learn CAL from drift: actual / predicted, blended 50/50, clamped to [1,4].
relearn() {
    _pred=$(measured_spend)
    awk -v bal="$BALANCE" -v act="$1" -v pred="$_pred" -v cal="$CAL" 'BEGIN{
        actual = bal - act; cal = cal + 0; if (cal <= 0) cal = 1;
        if (pred <= 0.02 || actual <= 0) { printf "%.4f", cal; exit }
        r = cal * actual / pred; n = 0.5 * cal + 0.5 * r;
        if (n < 1) n = 1; if (n > 4) n = 4; printf "%.4f", n }'
}

show_live() {
    if [ ! -f "$LIVE" ]; then
        echo "no live balance yet - run: ccredit refresh"; return
    fi
    IFS='|' read -r st ts bal used lim en ar tot drop cur < "$LIVE"
    age=$(( $(date +%s) - ${ts:-0} ))
    d() { awk -v c="$1" 'BEGIN{printf "%.2f", c/100}'; }
    if [ -n "$bal" ]; then
        printf 'balance      $%s %s\n' "$(d "$bal")" "${cur:-USD}"
        printf 'meter total  $%s (%s)\n' "$(d "${tot:-$bal}")" "$( [ -n "$(getk TOTAL)" ] && echo "set by hand" || echo "last top-up seen")"
        [ -n "$used" ] && printf 'this month   $%s%s\n' "$(d "$used")" "$( [ -n "$lim" ] && echo " of \$$(d "$lim") limit" || echo " (no monthly limit)")"
        printf 'extra usage  %s, auto-reload %s\n' "$( [ "$en" = 1 ] && echo on || { [ "$en" = 0 ] && echo off || echo unknown; })" "$( [ "$ar" = 1 ] && echo on || echo off)"
        [ -n "$drop" ] && printf 'last drop    %ss ago\n' "$(( $(date +%s) - drop ))"
    fi
    printf 'status       %s, fetched %ss ago\n' "$st" "$age"
    _mode=$(getk MODE); _win=$(getk ACTIVE_WINDOW)
    printf 'row mode     %s (window %ss)\n' "${_mode:-auto}" "${_win:-600}"
}

case "${1:-show}" in
    show) show_live ;;
    refresh)
        [ -x "$FETCH" ] || { echo "missing $FETCH" >&2; exit 1; }
        # --print waits for an in-flight fetch itself; never break its lock here.
        "$FETCH" --print ;;
    total)
        case "${2:-}" in
            auto|'') setk TOTAL "" ; echo "meter total: automatic (balance after the last top-up seen)" ;;
            *) num "$2" || { echo "usage: ccredit total <dollars|auto>" >&2; exit 1; }
               setk TOTAL "$(awk -v n="$2" 'BEGIN{printf "%.2f", n}')"; echo "meter total set to \$$(getk TOTAL)" ;;
        esac
        [ -x "$FETCH" ] && "$FETCH" >/dev/null 2>&1 || true ;;
    mode)
        case "${2:-}" in
            auto|credits|quota) setk MODE "$2"; echo "row mode: $2" ;;
            *) echo "usage: ccredit mode {auto|credits|quota}" >&2; exit 1 ;;
        esac ;;
    window)
        case "${2:-}" in ''|*[!0-9]*) echo "usage: ccredit window <seconds>" >&2; exit 1 ;; esac
        setk ACTIVE_WINDOW "$2"; echo "active window: ${2}s" ;;
    set)
        if [ -z "${2:-}" ]; then echo "usage: ccredit set <balance>" >&2; exit 1; fi
        num "$2" || { echo "usage: ccredit set <balance>" >&2; exit 1; }
        _was="$CAL"; _newcal=$(relearn "$2")
        write_anchor "$(awk -v n="$2" 'BEGIN{printf "%.2f", n}')" "$_newcal"
        echo "balance anchored at \$$(getk BALANCE)"
        [ "$_was" != "$_newcal" ] && echo "calibration $_was -> $_newcal (learned from drift)" || true ;;
    topup)
        if [ -z "${2:-}" ]; then echo "usage: ccredit topup <amount>" >&2; exit 1; fi
        num "$2" || { echo "usage: ccredit topup <amount>" >&2; exit 1; }
        write_anchor "$(awk -v a="$BALANCE" -v b="$2" 'BEGIN{printf "%.2f", a+b}')" "$CAL"
        echo "topped up \$$2 -> anchor \$$(getk BALANCE)" ;;
    cal)
        if [ -z "${2:-}" ]; then echo "usage: ccredit cal <factor>" >&2; exit 1; fi
        num "$2" || { echo "usage: ccredit cal <factor>" >&2; exit 1; }
        setk CAL "$(awk -v n="$2" 'BEGIN{printf "%.4f", n}')"; echo "calibration set to $(getk CAL)" ;;
    *) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
