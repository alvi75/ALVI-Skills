#!/usr/bin/env bash
# Credit balance anchor. No API returns a credit balance, so you set it once and
# the meter subtracts spend from there:
#   ccredit set 35.06     re-anchor to whatever Console shows now
#   ccredit topup 20      add a top-up to the current balance
#   ccredit show          print the anchor
set -euo pipefail
CFG="$HOME/.claude/credit-config"
LDIR="$HOME/.claude/credit-ledger.d"

write() {   # $1 balance   $2 calibration
    cat > "$CFG" <<EOF
# Claude Code credit meter.
# No API returns a credit balance, so BALANCE is entered by hand - the one
# number you type. Everything after it is measured automatically:
#     left now  =  BALANCE  -  spend since BALANCE_AT
# Update it with:  ccredit set <what Console shows>   |   ccredit topup <amount>
BALANCE=$1
BALANCE_AT=$(date -u +%Y-%m-%dT%H:%M:%SZ)
# CAL scales the local estimate. The transcript cannot see every billed call
# (auto-mode classifier, WebFetch summarizer), so the raw estimate runs low.
# Re-learned by 'ccredit set' from predicted-vs-actual drift. Note: no backticks
# in this heredoc - it is unquoted, so backticks would execute as a command.
CAL=$2
EOF
    chmod 600 "$CFG"
    # Both derived stores measure spend SINCE the anchor, so both reset with it.
    # Keeping them would re-subtract spend the new balance already accounts for.
    rm -rf "$LDIR" 2>/dev/null || true
    rm -f "${TMPDIR:-/tmp}"/cc-credit-spend-* 2>/dev/null || true
}

[ -f "$CFG" ] && . "$CFG"
: "${BALANCE:=0}" "${BALANCE_AT:=never}" "${CAL:=1.0}"

# Spend the meter has measured since the anchor, already scaled by CAL - i.e.
# exactly what the bar is currently claiming was spent.
measured_spend() {
    find "$LDIR" -type f -name 's-*' -print0 2>/dev/null \
      | xargs -0 cat 2>/dev/null \
      | awk -v c="$CAL" 'NF==3 { d=$3-$2; if(d<0) d=0; s+=$1+d }
                         END{ c=c+0; if(c<=0) c=1; printf "%.6f", (s+0)*c }'
}

# Learn CAL from drift: actual spend / spend we predicted. Blended 50/50 with the
# running value so one noisy re-anchor cannot throw it, and clamped to [1,4] -
# below 1 would mean the transcript saw MORE than was billed, which cannot happen,
# and above 4 is a sign the ledger was reset rather than a real ratio.
relearn() {   # $1 = actual balance now
    _pred=$(measured_spend)
    awk -v bal="$BALANCE" -v act="$1" -v pred="$_pred" -v cal="$CAL" 'BEGIN{
        actual = bal - act; cal = cal + 0; if (cal <= 0) cal = 1;
        if (pred <= 0.02 || actual <= 0) { printf "%.4f", cal; exit }
        r = cal * actual / pred;
        n = 0.5 * cal + 0.5 * r;
        if (n < 1) n = 1; if (n > 4) n = 4;
        printf "%.4f", n
    }'
}

case "${1:-show}" in
    set)
        if [ -z "${2:-}" ]; then echo "usage: ccredit set <balance>" >&2; exit 1; fi
        _was="$CAL"; _newcal=$(relearn "$2")
        write "$(awk -v n="$2" 'BEGIN{printf "%.2f", n}')" "$_newcal"; . "$CFG"
        echo "balance set to \$$BALANCE"
        [ "$_was" != "$CAL" ] && echo "calibration $_was -> $CAL (learned from drift)" ;;
    topup)
        if [ -z "${2:-}" ]; then echo "usage: ccredit topup <amount>" >&2; exit 1; fi
        write "$(awk -v a="$BALANCE" -v b="$2" 'BEGIN{printf "%.2f", a+b}')" "$CAL"; . "$CFG"
        echo "topped up \$$2" ;;
    cal)
        if [ -z "${2:-}" ]; then echo "usage: ccredit cal <factor>" >&2; exit 1; fi
        write "$BALANCE" "$(awk -v n="$2" 'BEGIN{printf "%.4f", n}')"; . "$CFG"
        echo "calibration set to $CAL" ;;
    show) ;;
    *) echo "usage: ccredit {set <balance>|topup <amount>|cal <factor>|show}" >&2; exit 1 ;;
esac

printf 'balance $%s as of %s (calibration %sx)\n' "$BALANCE" "$BALANCE_AT" "$CAL"
